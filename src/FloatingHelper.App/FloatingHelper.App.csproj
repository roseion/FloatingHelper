<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloatingHelper.Core\FloatingHelper.Core.csproj" />
    <ProjectReference Include="..\FloatingHelper.Plugins.Builtin\FloatingHelper.Plugins.Builtin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico">
      <Link>app.ico</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <!-- 避免 WinForms 隐式 using 与 WPF 类型产生歧义，改用显式别名引用 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
