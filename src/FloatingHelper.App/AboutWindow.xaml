<Window x:Class="FloatingHelper.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于浮动助手"
        Width="400"
        Height="290"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="浮动助手"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2D2D2D" />
            <TextBlock Text="划词工具栏 · MVP"
                       Foreground="#888888"
                       Margin="0,4,0,16" />
            <TextBlock Text="选中文字后自动弹出工具栏，支持复制 / 智能打开 / 搜索，动作以插件形式扩展。"
                       TextWrapping="Wrap"
                       Foreground="#444444" />

            <Border Margin="0,16,0,0"
                    Padding="12"
                    Background="#F6F6F6"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="#444444">
                        <Run Text="主页：" />
                        <Hyperlink NavigateUri="https://www.oldgao.com"
                                   RequestNavigate="OnRequestNavigate">www.oldgao.com</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="QQ：638694"
                               Foreground="#444444"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Button Grid.Row="1"
                Content="确定"
                HorizontalAlignment="Right"
                Padding="24,6"
                IsDefault="True"
                Click="OnOkClick" />
    </Grid>
</Window>
